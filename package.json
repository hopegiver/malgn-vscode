{
  "name": "malgn-vscode",
  "displayName": "Malgn",
  "description": "개발자 워크스테이션의 선언적 원하는 상태를 사람의 동의 아래 수렴시키는 리컨실러이며, malgn-agent의 설치·구동 표면(GUI)이다.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "build": "pnpm run check-types && pnpm run compile",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.24.0",
    "typescript": "~5.6.0",
    "vitest": "^2.1.0"
  }
}
