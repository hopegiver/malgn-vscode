#!/bin/sh
# pre-push 훅 — 이 저장소는 public이라 push 직전에 시크릿 유출을 마지막으로 한 번
# 더 잡는다("CI 탐지는 사후다 — 그래서 마지막 선이지 첫 선이 아니다").
#
# 로직은 scripts/pre-push-sensitive-scan.mjs(정본, 알려진 시크릿 패턴을 push될
# 커밋 범위의 diff에서 찾는다)를 그대로 실행한다. 2026-09-08 Electron→Tauri 전환
# 때 예전 버전이 의존하던 compat/sensitive-classes.json·scripts/lib/sensitiveScan.mjs가
# 함께 삭제되어, 그 자리를 대신하는 자체완결형 버전으로 교체했다.
#
# 활성화: git config core.hooksPath .githooks (활성화는 사람이 명시적으로 한다).

REPO_ROOT="$(git rev-parse --show-toplevel)"
node "$REPO_ROOT/scripts/pre-push-sensitive-scan.mjs"
exit $?
