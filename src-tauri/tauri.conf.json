{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "malgn-agent",
  "mainBinaryName": "malgn-agent",
  "version": "0.2.4",
  "identifier": "com.malgnsoft.agent",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "맑은에이전트",
        "width": 1180,
        "height": 760
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/hopegiver/malgn-vscode/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZDQTNCRjU2RTVFQkYwMzcKUldRMzhPdmxWcitqL0s4WmZJb25nS2UvN3VIVW9BYktuWG5Tb2VGUyt3QUh5YzJ5eWNDVE1jSlIK"
    }
  }
}
